<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Scan is intentionally local-first. Some transitive Google libraries declare
        INTERNET in their manifests even though Scan itself has no networking code.
        Remove that transitive permission from the final merged APK so the release
        privacy contract is enforced by the artifact itself.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <application
        android:name=".ScanApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_scan_logo"
        android:label="Scan"
        android:roundIcon="@drawable/ic_scan_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scan">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
